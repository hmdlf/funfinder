# Скопируйте в .env и заполните. Файл .env в git не попадает.

# --- Postgres (суперпользователь контейнера и владелец метабазы Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# --- База проекта ---
# Если в пароле есть символы @ : / ? # %, их нужно URL-кодировать:
# пароль попадает в строку подключения postgresql://user:pass@host/db.
FUNFINDER_DB_USER=funfinder
FUNFINDER_DB_PASSWORD=funfinder

# --- Секреты Airflow ---
# Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# --- VK ---
# Сервисный ключ приложения VK ID: id.vk.com → «Мои приложения» →
# создать приложение → «Сервисный ключ доступа». Даёт доступ только
# к публичным данным, логин пользователя не нужен.
VK_SERVICE_TOKEN=

# --- LLM: Yandex AI Studio ---
# API-ключ сервисного аккаунта с ролью ai.languageModels.user и id каталога,
# в котором он создан. Нужны для process_events (извлечение событий из постов).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- Linux: UID вашего пользователя, чтобы логи писались без проблем с правами.
# Узнать: id -u. На Windows и macOS оставьте 50000.
AIRFLOW_UID=50000
