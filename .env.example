# Шаблон .env. Создать .env: python scripts/init_env.py — он скопирует этот файл
# и сгенерирует пароли и секреты. Файл .env в git не попадает.

# --- Postgres (суперпользователь контейнера и владелец метабазы Airflow) ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=

# --- База проекта ---
# Если задаёте пароль вручную и в нём есть символы @ : / ? # %, их нужно
# URL-кодировать: пароль попадает в строку подключения postgresql://user:pass@host/db.
FUNFINDER_DB_USER=funfinder
FUNFINDER_DB_PASSWORD=

# --- Секреты Airflow ---
# Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# --- VK ---
# Сервисный ключ приложения VK ID: id.vk.com → «Мои приложения» →
# создать приложение → «Сервисный ключ доступа». Даёт доступ только
# к публичным данным, логин пользователя не нужен.
VK_SERVICE_TOKEN=

# --- LLM: Yandex AI Studio ---
# API-ключ сервисного аккаунта с ролью ai.languageModels.user и id каталога,
# в котором он создан. Нужны для process_events (извлечение событий из постов).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# --- Сайт ---
# Куда выкладывать собранный сайт (DAG build_site). Пустой SITE_DEPLOY_HOST —
# сайт собирается только локально, в site_build/site. Ключ деплоя и ключ
# сервера лежат в secrets/ (см. README, «Сайт: сервер»).
SITE_URL=https://matingu.com
SITE_DEPLOY_HOST=
SITE_DEPLOY_USER=deploy
SITE_DEPLOY_DIR=/var/www/matingu
# Контакт для организаторов в подвале сайта: почта или ссылка (https://vk.me/...).
SITE_CONTACT=

# --- Telegram ---
# true — загружать каналы через сервер сайта по SSH (SITE_DEPLOY_HOST и ключ
# из secrets/): нужно там, где t.me не открывается напрямую, например в России.
TG_FETCH_VIA_SSH=false
# Токен бота для подборки «Завтра в <городе>» (DAG publish): @BotFather → /newbot.
# Бота добавить в канал админом с правом публикации, канал — в раздел publish:
# в sources/<город>.yaml. Через сервер (TG_FETCH_VIA_SSH=true) идёт и отправка.
TG_BOT_TOKEN=

# --- Linux: UID вашего пользователя, чтобы логи писались без проблем с правами.
# Узнать: id -u. На Windows и macOS оставьте 50000.
AIRFLOW_UID=50000
