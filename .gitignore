.env
logs/*
!logs/.gitkeep
config/*
!config/.gitkeep
plugins/*
!plugins/.gitkeep
site_build/*
!site_build/.gitkeep
# ключ деплоя сайта и known_hosts сервера — никогда в git
secrets/*
!secrets/.gitkeep
__pycache__/
*.pyc
.pytest_cache/
.venv/
.idea/
.vscode/

# Черновики и выгрузки в корне — не для репозитория
/*.csv
/first_try.py
/scratch_*.py
/blur.txt
site_build/
